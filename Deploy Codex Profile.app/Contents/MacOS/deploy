#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
default_repo=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
repo_root=$default_repo
home_override=
no_dialog=${CODEX_PROFILE_LAUNCHER_NO_DIALOG:-0}

usage() {
  printf '%s\n' "Usage: Deploy Codex Profile.app/Contents/MacOS/deploy [--repo PATH] [--home PATH] [--no-dialog]" >&2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      repo_root=$2
      shift 2
      ;;
    --home)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      home_override=$2
      shift 2
      ;;
    --no-dialog)
      no_dialog=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    /*)
      if [ "$repo_root" = "$default_repo" ]; then repo_root=$1; shift; else usage; exit 2; fi
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

repo_root=$(CDPATH= cd -- "$repo_root" 2>/dev/null && pwd) || {
  printf '%s\n' "无法找到治理仓库目录：$repo_root" >&2
  exit 1
}
deploy_script="$repo_root/scripts/deploy-codex-profile-mac.sh"
if [ ! -x "$deploy_script" ]; then
  printf '%s\n' "选中的目录不是治理模板仓库，缺少 scripts/deploy-codex-profile-mac.sh：$repo_root" >&2
  exit 1
fi

path_prefix=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin
if [ -n "${PATH:-}" ]; then path_prefix="$path_prefix:$PATH"; fi
export PATH=$path_prefix
cd "$repo_root"

tmp_output=$(mktemp "${TMPDIR:-/tmp}/codex-profile-deploy.XXXXXX")
trap 'rm -f "$tmp_output"' EXIT INT TERM
set +e
if [ -n "$home_override" ]; then
  HOME="$home_override" "$deploy_script" --home "$home_override" >"$tmp_output" 2>&1
else
  "$deploy_script" >"$tmp_output" 2>&1
fi
status=$?
set -e
output=$(cat "$tmp_output")

show_message() {
  title=$1
  message=$2
  if [ "$no_dialog" = "1" ] || ! command -v osascript >/dev/null 2>&1; then
    printf '%s\n%s\n' "$title" "$message"
    return 0
  fi
  osascript - "$title" "$message" <<'APPLESCRIPT' >/dev/null 2>&1 || {
on run argv
  display dialog (item 2 of argv) with title (item 1 of argv) buttons {"OK"} default button "OK"
end run
APPLESCRIPT
    printf '%s\n%s\n' "$title" "$message"
  }
}

if [ "$status" -eq 0 ]; then
  message=$(printf '%s\n\n%s' "已部署到当前用户目录。此电脑上的所有 Codex 工作区现在共用这套配置。" "$output")
  show_message "Codex 全局配置已部署" "$message"
else
  show_message "Codex 全局配置部署失败" "$output"
fi
exit "$status"
