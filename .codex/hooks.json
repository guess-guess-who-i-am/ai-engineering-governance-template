{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/turn-start.mjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/turn-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stop-postflight.mjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stop-postflight.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
