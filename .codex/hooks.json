{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh .codex/hooks/run-node-hook.sh turn-start.mjs",
            "commandWindows": "node .codex/hooks/turn-start.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh .codex/hooks/run-node-hook.sh stop-postflight.mjs",
            "commandWindows": "node .codex/hooks/stop-postflight.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
