{
  "schema": "quality-gates/v1",
  "projectKind": "governance-template",
  "requiredCategories": [
    "requirements",
    "governance",
    "functional",
    "unit",
    "integration",
    "contract",
    "e2e",
    "accessibility",
    "performance",
    "security",
    "dependency-security",
    "container-security",
    "compatibility",
    "deployment",
    "qualitative",
    "data-quality"
  ],
  "gates": [
    {
      "id": "governance-structure",
      "category": "governance",
      "state": "active",
      "failurePriority": "P1",
      "owner": "governance-maintainers",
      "remediation": "Restore the required governance structure and authority routing, then rerun the gate.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/validate-governance.ps1"]
      }
    },
    {
      "id": "skill-packages",
      "category": "governance",
      "state": "active",
      "failurePriority": "P1",
      "owner": "governance-maintainers",
      "remediation": "Repair the reported Skill package or metadata contract and rerun Skill validation.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-skill-validation.ps1"]
      }
    },
    {
      "id": "findings-contract",
      "category": "governance",
      "state": "active",
      "failurePriority": "P1",
      "owner": "governance-maintainers",
      "remediation": "Repair the Finding schema, deduplication, priority, or lifecycle behavior and rerun its contract test.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-findings.ps1"]
      }
    },
    {
      "id": "quality-runner-contract",
      "category": "governance",
      "state": "active",
      "failurePriority": "P1",
      "owner": "governance-maintainers",
      "remediation": "Restore all-gate execution, aggregate failure reporting, and per-gate Finding preservation.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-quality-gate-runner.ps1"]
      }
    },
    {
      "id": "design-reference-catalog",
      "category": "functional",
      "state": "active",
      "failurePriority": "P2",
      "owner": "design-maintainers",
      "remediation": "Repair catalog completeness, search, install safety, or provenance and rerun the design-reference test.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-design-references.ps1"]
      }
    },
    {
      "id": "kest-flow-contract",
      "category": "e2e",
      "state": "active",
      "failurePriority": "P2",
      "owner": "test-maintainers",
      "remediation": "Restore the Kest step, capture, assertion, edge, HTTPS, and report configuration contract.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-kest-flow-contract.ps1"]
      }
    },
    {
      "id": "document-integrity",
      "category": "governance",
      "state": "active",
      "failurePriority": "P2",
      "owner": "documentation-maintainers",
      "remediation": "Repair invalid encoding, malformed JSON, terminology drift, or broken tracked links.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/validate-documents.ps1"]
      }
    },
    {
      "id": "release-contract",
      "category": "governance",
      "state": "active",
      "failurePriority": "P1",
      "owner": "release-maintainers",
      "remediation": "Align VERSION, package metadata, changelog, tag policy, and release workflow before publishing.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-release-contract.ps1"]
      }
    },
    {
      "id": "upstream-drift",
      "category": "dependency-security",
      "state": "active",
      "failurePriority": "P2",
      "owner": "governance-maintainers",
      "remediation": "Review the upstream comparison, license and adopted behavior, then deliberately update the pinned commit or document the hold.",
      "profiles": ["nightly"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/check-upstream-drift.ps1", "-FailOnDrift"]
      }
    },
    {
      "id": "story-traceability",
      "category": "requirements",
      "state": "active",
      "failurePriority": "P1",
      "owner": "product-maintainers",
      "remediation": "Restore stable user-story acceptance criteria and map each verified criterion to existing evidence.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/validate-user-stories.ps1"]
      }
    },
    {
      "id": "template-bootstrap",
      "category": "functional",
      "state": "active",
      "failurePriority": "P1",
      "owner": "template-maintainers",
      "remediation": "Repair the generated-project journey and its failure semantics, then rerun the bootstrap test.",
      "userStory": "US-001",
      "acceptanceCriteria": ["AC-001", "AC-002"],
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-new-project.ps1"]
      }
    },
    {
      "id": "security-baseline",
      "category": "security",
      "state": "active",
      "failurePriority": "P0",
      "owner": "security-maintainers",
      "remediation": "Remove the exposed secret or unsafe workflow condition before any merge or release.",
      "profiles": ["pr", "release", "nightly"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/validate-security-baseline.ps1"]
      }
    },
    {
      "id": "application-security",
      "category": "security",
      "state": "not-applicable",
      "rationale": "The template has no authentication, authorization, tenant, user-data, or application telemetry boundary."
    },
    {
      "id": "llm-qualitative",
      "category": "qualitative",
      "state": "active",
      "failurePriority": "P2",
      "owner": "design-maintainers",
      "remediation": "Review the cited qualitative evidence, correct the target artifact or calibration, and rerun the model gate.",
      "profiles": ["qualitative"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/invoke-qualitative-gate.ps1"]
      }
    },
    {
      "id": "qualitative-adapter-contract",
      "category": "qualitative",
      "state": "active",
      "failurePriority": "P1",
      "owner": "platform-maintainers",
      "remediation": "Restore the Responses API request, strict output contract, credential guard, or calibration behavior.",
      "userStory": "US-002",
      "acceptanceCriteria": ["AC-001", "AC-002", "AC-003"],
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-qualitative-gate.ps1"]
      }
    },
    {
      "id": "unit-tests",
      "category": "unit",
      "state": "not-applicable",
      "rationale": "This repository contains governance scripts rather than an application library. Generated projects must replace this decision after choosing a runtime."
    },
    {
      "id": "integration-tests",
      "category": "integration",
      "state": "not-applicable",
      "rationale": "The template has no database, message broker, browser runtime, or service integration."
    },
    {
      "id": "public-contract-tests",
      "category": "contract",
      "state": "not-applicable",
      "rationale": "The template does not publish an HTTP, event, database, or package contract."
    },
    {
      "id": "accessibility-tests",
      "category": "accessibility",
      "state": "active",
      "failurePriority": "P1",
      "owner": "design-maintainers",
      "remediation": "Restore semantic structure, focus behavior, responsive rules, reduced motion, and automated accessibility evidence.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/test-docs-site.ps1"]
      }
    },
    {
      "id": "performance-regression",
      "category": "performance",
      "state": "active",
      "failurePriority": "P2",
      "owner": "design-maintainers",
      "remediation": "Reduce documentation assets or explicitly review and revise the measured budget with comparable evidence.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/validate-site-performance.ps1"]
      }
    },
    {
      "id": "dependency-vulnerability-scan",
      "category": "dependency-security",
      "state": "active",
      "failurePriority": "P0",
      "owner": "security-maintainers",
      "remediation": "Upgrade or remove vulnerable locked dependencies and preserve the browser evidence contract.",
      "profiles": ["release", "nightly"],
      "workingDirectory": ".",
      "command": {
        "executable": "npm",
        "arguments": ["audit", "--package-lock-only", "--audit-level=high"]
      }
    },
    {
      "id": "container-supply-chain",
      "category": "container-security",
      "state": "not-applicable",
      "rationale": "The template does not build or publish a container image."
    },
    {
      "id": "runtime-compatibility",
      "category": "compatibility",
      "state": "not-applicable",
      "rationale": "Application runtime and datastore compatibility matrices belong to the generated project."
    },
    {
      "id": "deployment-smoke",
      "category": "deployment",
      "state": "active",
      "failurePriority": "P1",
      "owner": "release-maintainers",
      "remediation": "Restore the GitHub Pages build, environment URL, deployment action, and live post-deploy content smoke.",
      "profiles": ["pr", "release"],
      "workingDirectory": ".",
      "command": {
        "executable": "pwsh",
        "arguments": ["-NoProfile", "-File", "scripts/validate-pages-deployment.ps1"]
      }
    },
    {
      "id": "research-data-quality",
      "category": "data-quality",
      "state": "not-applicable",
      "rationale": "The template does not contain a research dataset or analytical pipeline."
    }
  ]
}
